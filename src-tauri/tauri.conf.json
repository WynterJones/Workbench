{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbench",
  "version": "1.0.2",
  "identifier": "com.wynterjones.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#09090b",
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/Volumes/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Wynter Jones (7X2UF4FZHC)",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "category": "public.app-category.developer-tools",
    "shortDescription": "A visual library of everything you have ever built.",
    "longDescription": "Workbench scans your drives, identifies every project by framework, runs the ones you trust, screenshots them, and turns a decade of scattered folders into a browsable catalog.",
    "copyright": "Copyright (c) 2026 Wynter Jones"
  }
}